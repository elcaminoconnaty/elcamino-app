NEXT_PUBLIC_SUPABASE_URL=https://btunvfrxegjwpznlmvjp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_SOGehRHFABOoyUHu1OfTHQ_282e2Kkj

# Necesaria para el botón "Importar desde correo" en reservas
# (usa Claude Haiku 4.5 para parsear el cuerpo de los correos de proveedores)
ANTHROPIC_API_KEY=

# --- Contratos y correo ---

# La URL pública de la plataforma, SIN barra final. Sin esto el enlace de firma que le
# llega al peregrino apunta a localhost y el contrato no se puede firmar.
# En producción: https://elcamino-app-production.up.railway.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Los correos salen por la API de Brevo, sobre HTTPS. NO por SMTP: Railway desactiva el SMTP
# saliente en los planes Free, Trial y Hobby, así que el envío por Gmail funcionaba en local
# y en producción se colgaba hasta un "Connection timeout". Es lo mismo que usa Camino Sacro.
# La clave se genera en Brevo → SMTP & API → API Keys.
BREVO_API_KEY=

# Desde qué dirección salen. NO es un buzón: no tiene contraseña ni bandeja de entrada, es
# solo la etiqueta del "De:". Lo único que se exige es que el dominio esté autenticado en
# Brevo (Senders, Domains & Dedicated IPs → elcaminoconnaty.com, con sus DKIM en Cloudflare,
# que es donde vive el DNS de este dominio). No vale un @gmail.com: Brevo no puede firmar
# como Google, el correo llega sin coincidir la firma con el remitente y Outlook y Hotmail
# lo mandan a spam — con el código de firma, que dura 10 minutos, eso rompe el flujo.
# El responder-a sí es elcaminoconnaty@gmail.com, y eso va en el código (CONTACTO.correo):
# el peregrino le da a Responder y le cae a Naty donde siempre.
BREVO_SENDER_EMAIL=reservas@elcaminoconnaty.com

# Llave de servicio de Supabase. Se salta RLS, así que NUNCA va al navegador — solo la usa
# el servidor para el flujo público de firma, donde el peregrino llega sin cuenta y lo que
# lo autoriza es el token de su enlace. Sin esto, la página de firma responde
# "enlace no válido" a todo el mundo.
# Se copia de Supabase → Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=

# --- Correo a proveedores por Gmail (mismo hilo) ---

# Los correos a hoteles y restaurantes (rooming list, menú) salen desde
# elcaminoconnaty@gmail.com y DENTRO del hilo de la reserva. Eso no lo puede hacer Brevo:
# lo hace n8n con la credencial Gmail OAuth de esa cuenta, a través del workflow
# "Plataforma → Gmail (hilos y envíos)". La plataforma le pega a su webhook con un secreto
# en el header x-webhook-secret. Sin estas dos variables, el botón "Enviar" avisa que Gmail
# no está configurado y ofrece mandarlo por Brevo (fuera del hilo).
N8N_GMAIL_WEBHOOK_URL=https://primary-production-d866.up.railway.app/webhook/plataforma-gmail
N8N_GMAIL_SECRET=
