NEXT_PUBLIC_SUPABASE_URL=https://btunvfrxegjwpznlmvjp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_SOGehRHFABOoyUHu1OfTHQ_282e2Kkj

# Necesaria para el botón "Importar desde correo" en reservas
# (usa Claude Haiku 4.5 para parsear el cuerpo de los correos de proveedores)
ANTHROPIC_API_KEY=

# --- Contratos y correo ---

# La URL pública de la plataforma, SIN barra final. Sin esto el enlace de firma que le
# llega al peregrino apunta a localhost y el contrato no se puede firmar.
# En producción: https://elcamino-app-production.up.railway.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Los correos salen por Gmail SMTP, así que el remitente es literalmente el buzón que los
# peregrinos ya conocen y de DKIM/SPF/DMARC se encarga Google.
# La contraseña NO es la de la cuenta: se genera en
#   Cuenta de Google → Seguridad → Verificación en dos pasos → Contraseñas de aplicaciones
# Sin estas dos variables no sale ningún correo (y por tanto no se puede enviar a firmar).
GMAIL_USER=elcaminoconnaty@gmail.com
GMAIL_APP_PASSWORD=

# Llave de servicio de Supabase. Se salta RLS, así que NUNCA va al navegador — solo la usa
# el servidor para el flujo público de firma, donde el peregrino llega sin cuenta y lo que
# lo autoriza es el token de su enlace. Sin esto, la página de firma responde
# "enlace no válido" a todo el mundo.
# Se copia de Supabase → Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=
